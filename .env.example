# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Channel ID of your welcome channel (right-click channel → Copy Channel ID)
WELCOME_CHANNEL_ID=123456789012345678

# Optional: URL of your welcome banner image (shown at the bottom of the embed)
WELCOME_BANNER_URL=

# --- Whitelist system ---
# Channel where players click Request Whitelist / No Vouch
WHITELIST_PANEL_CHANNEL_ID=123456789012345678

# Channel where staff see submitted applications (Request Whitelist)
WHITELIST_APP_CHANNEL_ID=123456789012345678

# Channel where No Vouch / admin interview applications go
WHITELIST_NO_VOUCH_CHANNEL_ID=123456789012345678

# Role given when an application is approved
CITIZEN_ROLE_ID=123456789012345678

# --- Staff roles ---
MODERATOR_ROLE_ID=123456789012345678
ADMIN_ROLE_ID=123456789012345678
HEAD_ADMIN_ROLE_ID=
# Extra power roles (comma-separated) — approve powers, not pinged
POWER_ROLE_IDS=
# Only one role is pinged on new tickets
TICKET_PING_ROLE_ID=123456789012345678
STAFF_ROLE_ID=123456789012345678
PREFIX_ROLE_IDS=

# Live moderation log channel for $ban/$kick/$mute/etc
MOD_LOG_CHANNEL_ID=123456789012345678

# --- Loggers ---
WHITELIST_LOG_CHANNEL_ID=
RENAME_LOG_CHANNEL_ID=
ROLE_REQUEST_LOG_CHANNEL_ID=
UNROLE_LOG_CHANNEL_ID=
MESSAGE_LOG_CHANNEL_ID=

# Token bait channel — anyone who chats gets kicked
TOKEN_DETECTOR_CHANNEL_ID=1554208720873848913

# Optional: server logo URL for embeds (defaults to server icon)
SERVER_LOGO_URL=

# --- Rename system ---
# Channel where /rename is allowed (defaults to 1553608159279579196)
RENAME_CHANNEL_ID=1553608159279579196

# --- Role request system ---
# Channel where /requestrole is allowed (leave empty to allow any channel)
ROLE_REQUEST_CHANNEL_ID=
# Optional: comma-separated leadership role IDs (gang / police / doctor heads) who can Approve/Deny
ROLE_REQUEST_APPROVER_ROLE_IDS=
# Optional: map Discord role IDs to nick prefixes (auto EMS/PD from role name if unset)
# Example: 111:EMS,222:PD,333:BALLAS  → nick becomes "EMS | Smookey"
ROLE_NICK_PREFIX_MAP=

# --- Unrole system ---
# Channel where /unrole is allowed
UNROLE_CHANNEL_ID=1553608201440858124
# Optional: same as ROLE_REQUEST_APPROVER_ROLE_IDS if left empty
UNROLE_APPROVER_ROLE_IDS=

# --- Ticket system ---
# Channel where the Create Ticket panel is posted
TICKET_PANEL_CHANNEL_ID=123456789012345678

# Category where ticket channels are created
TICKET_CATEGORY_ID=123456789012345678

# Default transcript / log channel (fallback)
TICKET_LOG_CHANNEL_ID=123456789012345678
TICKET_TRANSCRIPT_CHANNEL_ID=123456789012345678

# Per-category transcript routing: categoryId:transcriptChannelId,...
# Uses the ticket's CURRENT parent category (so dragged tickets still route correctly)
TICKET_TRANSCRIPT_MAP=categoryId:transcriptChannelId
